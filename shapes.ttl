@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix : <http://www.univ-projet.fr/ontologies/autosemantica#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

:CarShape
    a sh:NodeShape ;
    sh:targetClass :Car ;
    sh:property [
        sh:path :manufacturedBy ;
        sh:minCount 1 ;
        sh:class :Manufacturer ;
        sh:message "Each car must be linked to a manufacturer." ;
    ] ;
    sh:property [
        sh:path :averagePrice ;
        sh:datatype xsd:float ;
        sh:minInclusive 0 ;
        sh:message "The average price cannot be negative." ;
    ] ;
    sh:property [
        sh:path :co2Emission ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:message "CO2 emissions must be positive." ;
    ] ;
    sh:property [
        sh:path :doorCount ;
        sh:datatype xsd:integer ;
        sh:minInclusive 2 ;
        sh:maxInclusive 5 ;
        sh:message "The number of doors must be between 2 and 5." ;
    ] ;
    sh:property [
        sh:path :hasBodyType ;
        sh:class skos:Concept ;
        sh:message "The body type must be a SKOS concept." ;
    ] ;
    sh:property [
        sh:path :trunkVolume ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:message "The trunk volume must be positive." ;
    ] .

:VehicleShape
    a sh:NodeShape ;
    sh:targetClass :Vehicle ;
    sh:property [
        sh:path :weight ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:message "The weight must be positive." ;
    ] ;
    sh:property [
        sh:path :range ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:message "The range must be positive." ;
    ] ;
    sh:property [
        sh:path :seatCount ;
        sh:datatype xsd:integer ;
        sh:minInclusive 1 ;
        sh:message "A vehicle must have at least one seat." ;
    ] ;
    sh:property [
        sh:path :releaseYear ;
        sh:datatype xsd:integer ;
        sh:minInclusive 1886 ;
        sh:message "The year of release must be greater than 1886." ;
    ] ;
    sh:property [
        sh:path :phase ;
        sh:datatype xsd:integer ;
        sh:minInclusive 1 ;
        sh:message "The phase must be an integer greater than or equal to 1." ;
    ] ;
    sh:property [
        sh:path :hasFuelType ;
        sh:class skos:Concept ;
    ] ;
    sh:property [
        sh:path :hasTransmissionType ;
        sh:class skos:Concept ;
    ] ;
    sh:property [
        sh:path :hasDriveType ;
        sh:class skos:Concept ;
    ] .

:EngineShape
    a sh:NodeShape ;
    sh:targetClass :Engine ;
    sh:property [
        sh:path :power ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:message "The power must be positive." ;
    ] ;
    sh:property [
        sh:path :torque ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:message "The torque must be positive." ;
    ] .

:CustomerReviewShape
    a sh:NodeShape ;
    sh:targetClass :CustomerReview ;
    sh:property [
        sh:path :userRating ;
        sh:datatype xsd:integer ;
        sh:minInclusive 1 ;
        sh:maxInclusive 5 ;
        sh:message "The user rating must be between 1 and 5." ;
    ] ;
    sh:property [
        sh:path :concernsVehicle ;
        sh:minCount 1 ;
        sh:class :Vehicle ;
        sh:message "A review must concern a vehicle." ;
    ] .