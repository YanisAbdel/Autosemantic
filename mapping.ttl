@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix : <http://www.univ-projet.fr/ontologies/autosemantic#> .
@base <http://www.univ-projet.fr/ontologies/autosemantic> .

#################################################################
#    Mapping des Véhicules (vehicles_clean.csv)
#################################################################

<#VehiclesMap>
    a rr:TriplesMap ;

    rml:logicalSource [
        rml:source "data/vehicles_clean.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;

    rr:subjectMap [
        rr:template "http://www.univ-projet.fr/ontologies/autosemantic/vehicle/{id}" ;
        rr:class :Car
    ] ;

    # Label (modèle + année)
    rr:predicateObjectMap [
        rr:predicate rdfs:label ;
        rr:objectMap [ 
            rr:template "{year} {make} {model}" 
        ]
    ] ;

    # Fabricant (hasManufacturer) -> Concept SKOS
    rr:predicateObjectMap [
        rr:predicate :hasManufacturer ;
        rr:objectMap [ 
            rr:template "http://www.univ-projet.fr/ontologies/autosemantic#{make}" ;
            rr:termType rr:IRI
        ]
    ] ;

    # Nombre de cylindres (numberOfCylinders)
    rr:predicateObjectMap [
        rr:predicate :numberOfCylinders ;
        rr:objectMap [ 
            rml:reference "cylinders" ; 
            rr:datatype xsd:integer 
        ]
    ] ;

    # Cylindrée (engineDisplacement)
    rr:predicateObjectMap [
        rr:predicate :engineDisplacement ;
        rr:objectMap [ 
            rml:reference "displ" ; 
            rr:datatype xsd:float 
        ]
    ] ;

    # Type de transmission (hasTransmissionType) -> Concept SKOS
    rr:predicateObjectMap [
        rr:predicate :hasTransmissionType ;
        rr:objectMap [ 
            rr:template "http://www.univ-projet.fr/ontologies/autosemantic#{trany}" ;
            rr:termType rr:IRI
        ]
    ] ;

    # Type de motricité (hasDriveType) -> Concept SKOS
    rr:predicateObjectMap [
        rr:predicate :hasDriveType ;
        rr:objectMap [ 
            rr:template "http://www.univ-projet.fr/ontologies/autosemantic#{drive}" ;
            rr:termType rr:IRI
        ]
    ] ;

    # Type de carburant (hasFuelType) -> Concept SKOS
    rr:predicateObjectMap [
        rr:predicate :hasFuelType ;
        rr:objectMap [ 
            rr:template "http://www.univ-projet.fr/ontologies/autosemantic#{fuelType}" ;
            rr:termType rr:IRI
        ]
    ] ;

    # Classe de véhicule (hasVehicleClass) -> Concept SKOS
    rr:predicateObjectMap [
        rr:predicate :hasVehicleClass ;
        rr:objectMap [ 
            rr:template "http://www.univ-projet.fr/ontologies/autosemantic#{VClass}" ;
            rr:termType rr:IRI
        ]
    ] .

#################################################################
#    Mapping des Avis Clients (reviews_final_clean.csv)
#################################################################

<#ReviewsMap>
    a rr:TriplesMap ;

    rml:logicalSource [
        rml:source "data/reviews_final_clean.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;

    rr:subjectMap [
        rr:template "http://www.univ-projet.fr/ontologies/autosemantic/review/{Brand}_{Review_Year}_{Rating}" ;
        rr:class :CustomerReview
    ] ;

    # Contenu de l'avis (reviewContent)
    rr:predicateObjectMap [
        rr:predicate :reviewContent ;
        rr:objectMap [ 
            rml:reference "Review" ;
            rr:datatype xsd:string
        ]
    ] ;

    # Note de l'avis (reviewRating)
    rr:predicateObjectMap [
        rr:predicate :reviewRating ;
        rr:objectMap [ 
            rml:reference "Rating" ; 
            rr:datatype xsd:decimal 
        ]
    ] .

#################################################################
#    Mapping des Concepts SKOS pour Fabricants
#################################################################

<#ManufacturerConceptsMap>
    a rr:TriplesMap ;

    rml:logicalSource [
        rml:source "data/vehicles_clean.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;

    rr:subjectMap [
        rr:template "http://www.univ-projet.fr/ontologies/autosemantic#{make}" ;
        rr:class skos:Concept
    ] ;

    # inScheme
    rr:predicateObjectMap [
        rr:predicate skos:inScheme ;
        rr:objectMap [ 
            rr:constant <http://www.univ-projet.fr/ontologies/autosemantic#ManufacturerScheme> 
        ]
    ] ;

    # prefLabel
    rr:predicateObjectMap [
        rr:predicate skos:prefLabel ;
        rr:objectMap [ 
            rml:reference "make" 
        ]
    ] .

