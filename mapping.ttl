@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix : <http://www.univ-projet.fr/ontologies/autosemantica#> .
@base <http://www.univ-projet.fr/ontologies/autosemantica> .

# Mapping for vehicles - uses expected_cols_vehicles
<#VehiclesCSVMap>
    a rr:TriplesMap ;

    rml:logicalSource [
        rml:source "data/vehicles_clean.csv" ;
        rml:referenceFormulation ql:CSV;
        rml:iterator "$"
    ] ;

    rr:subjectMap [
        rr:template "http://www.univ-projet.fr/ontologies/autosemantica/vehicle/{id}" ;
        rr:class :Vehicle 
    ] ;

    # Brand (make)
    rr:predicateObjectMap [
        rr:predicate :manufacturedBy ;
        rr:objectMap [ 
            rr:template "http://www.univ-projet.fr/ontologies/autosemantica/manufacturer/{make}" ;
        ]
    ] ;

    # Model
    rr:predicateObjectMap [
        rr:predicate rdfs:label ;
        rr:objectMap [ rml:reference "model" ]
    ] ;

    # Year
    rr:predicateObjectMap [
        rr:predicate :modelYear ;
        rr:objectMap [ rml:reference "year" ; rr:datatype xsd:integer ]
    ] ;

    # Body type (VClass)
    rr:predicateObjectMap [
        rr:predicate :hasBodyType ;
        rr:objectMap [ 
            rr:template "http://www.univ-projet.fr/ontologies/autosemantica/body/{VClass}" ;
        ]
    ] ;

    # Drive type (drive)
    rr:predicateObjectMap [
        rr:predicate :hasDriveType ;
        rr:objectMap [ 
            rr:template "http://www.univ-projet.fr/ontologies/autosemantica/drive/{drive}" ;
        ]
    ] ;

    # Transmission description (trans_dscr)
    rr:predicateObjectMap [
        rr:predicate :transmissionDescription ;
        rr:objectMap [ rml:reference "trans_dscr" ]
    ] ;

    # Transmission type (trany)
    rr:predicateObjectMap [
        rr:predicate :hasTransmissionType ;
        rr:objectMap [ 
            rr:template "http://www.univ-projet.fr/ontologies/autosemantica/transmission/{trany}" ;
        ]
    ] ;

    # Number of cylinders (cylinders)
    rr:predicateObjectMap [
        rr:predicate :cylinderCount ;
        rr:objectMap [ rml:reference "cylinders" ; rr:datatype xsd:integer ]
    ] ;

    # Fuel type (fuelType)
    rr:predicateObjectMap [
        rr:predicate :hasFuelType ;
        rr:objectMap [ 
            rr:template "http://www.univ-projet.fr/ontologies/autosemantica/fuel/{fuelType}" ;
        ]
    ] ;

    # CO2 emissions (co2)
    rr:predicateObjectMap [
        rr:predicate :co2Emission ;
        rr:objectMap [ rml:reference "co2" ; rr:datatype xsd:float ]
    ] ;

    # Displacement (displ)
    rr:predicateObjectMap [
        rr:predicate :engineDisplacement ;
        rr:objectMap [ rml:reference "displ" ; rr:datatype xsd:float ]
    ] ;

    # Has engine
    rr:predicateObjectMap [
        rr:predicate :hasEngine ;
        rr:objectMap [ 
            rr:template "http://www.univ-projet.fr/ontologies/autosemantica/engine/{id}" ;
        ]
    ] ;

    # Base model
    rr:predicateObjectMap [
        rr:predicate :baseModel ;
        rr:objectMap [ rml:reference "baseModel" ]
    ] .

# Mapping for engines - uses vehicles data
<#MotorsMap>
    a rr:TriplesMap ;

    rml:logicalSource [
        rml:source "data/vehicles_clean.csv" ;
        rml:referenceFormulation ql:CSV;
        rml:iterator "$"
    ] ;

    rr:subjectMap [
        rr:template "http://www.univ-projet.fr/ontologies/autosemantica/engine/{id}" ;
        rr:class :Engine 
    ] ;

    # Number of cylinders
    rr:predicateObjectMap [
        rr:predicate :cylinderCount ;
        rr:objectMap [ rml:reference "cylinders" ; rr:datatype xsd:float ]
    ] ;

    # Displacement
    rr:predicateObjectMap [
        rr:predicate :displacement ;
        rr:objectMap [ rml:reference "displ" ; rr:datatype xsd:float ]
    ] .

# Mapping for manufacturers
<#ManufacturersMap>
    a rr:TriplesMap ;

    rml:logicalSource [
        rml:source "data/vehicles_clean.csv" ;
        rml:referenceFormulation ql:CSV;
        rml:iterator "$"
    ] ;

    rr:subjectMap [
        rr:template "http://www.univ-projet.fr/ontologies/autosemantica/manufacturer/{make}" ;
        rr:class :Manufacturer 
    ] ;

    # Manufacturer name
    rr:predicateObjectMap [
        rr:predicate rdfs:label ;
        rr:objectMap [ rml:reference "make" ]
    ] .

# Mapping for customer reviews - uses expected_cols_reviews
<#ReviewsCSVMap>
    a rr:TriplesMap ;

    rml:logicalSource [
        rml:source "data/reviews_final_clean.csv" ;
        rml:referenceFormulation ql:CSV;
        rml:iterator "$"
    ] ;

    rr:subjectMap [
        rr:template "http://www.univ-projet.fr/ontologies/autosemantica/review/{Brand}_{Review_Year}_{Rating}" ;
        rr:class :CustomerReview 
    ] ;

    # Review content
    rr:predicateObjectMap [
        rr:predicate :reviewContent ;
        rr:objectMap [ rml:reference "Review" ]
    ] ;

    # Rating
    rr:predicateObjectMap [
        rr:predicate :userRating ;
        rr:objectMap [ rml:reference "Rating" ; rr:datatype xsd:float ]
    ] ;

    # Brand
    rr:predicateObjectMap [
        rr:predicate :reviewBrand ;
        rr:objectMap [ rml:reference "Brand" ]
    ] ;

    # Review year
    rr:predicateObjectMap [
        rr:predicate :reviewYear ;
        rr:objectMap [ rml:reference "Review_Year" ; rr:datatype xsd:integer ]
    ] ;

    # Review transmission type
    rr:predicateObjectMap [
        rr:predicate :reviewTransmissionType ;
        rr:objectMap [ rml:reference "Review_Trans_Type" ]
    ] ;

    # Review engine displacement
    rr:predicateObjectMap [
        rr:predicate :reviewEngineDisplacement ;
        rr:objectMap [ rml:reference "Review_Engine_Disp" ; rr:datatype xsd:float ]
    ] ;

    # Review model
    rr:predicateObjectMap [
        rr:predicate :reviewModel ;
        rr:objectMap [ rml:reference "Review_Model" ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate :concernsVehicle ;
        rr:objectMap [
            rr:parentTriplesMap <#VehiclesCSVMap> ;
            rr:joinCondition [
                rr:child "Brand" ;
                rr:parent "make" 
            ] ;
            rr:joinCondition [
                rr:child "Review_Year" ;
                rr:parent "year" 
            ] ;
            rr:joinCondition [
                rr:child "Review_Model" ;
                rr:parent "model" 
            ]
        ]
    ] .

