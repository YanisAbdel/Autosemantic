import streamlit as st
from rdflib import Graph, Namespace
import pandas as pd
import urllib.parse

st.set_page_config(page_title="AutoSemantica", page_icon="🚗", layout="wide")
AUTO = Namespace("http://www.univ-projet.fr/ontologies/autosemantic#")

@st.cache_resource
def load_graph():
    g = Graph()
    files = ["graph/autosemantic.ttl", "graph/output.ttl"]
    print("\n--- CHARGEMENT ---")
    for f in files:
        try:
            g.parse(f, format="turtle")
            print(f"✅ {f} chargé.")
        except Exception as e: st.error(f"Erreur {f}: {e}")
    print(f"📊 Total: {len(g)} triplets")
    return g

g = load_graph()

def clean_uri(uri):
    if not uri: return "N/A"
    return urllib.parse.unquote(str(uri).split('#')[-1].split('/')[-1]).replace('_', ' ')

# --- SIDEBAR ---
st.sidebar.title("🔍 Filtres")
res_manuf = g.query("PREFIX : <http://www.univ-projet.fr/ontologies/autosemantic#> SELECT DISTINCT ?m WHERE { ?car :hasManufacturer ?m } ORDER BY ?m")
manuf_map = {clean_uri(row.m): str(row.m) for row in res_manuf}
liste_manuf = sorted(list(manuf_map.keys()))
liste_manuf.insert(0, "Tous")
choix_manuf = st.sidebar.selectbox("Fabricant", liste_manuf)

# --- RECHERCHE ---
tab1, tab2 = st.tabs(["🚙 Recherche", "📊 Stats"])

with tab1:
    st.header("Véhicules")
    
    filter_clause = ""
    if choix_manuf != "Tous":
        filter_clause = f'FILTER(STR(?manufURI) = "{manuf_map[choix_manuf]}")'

    # ON RECUPERE TOUT CE QU'ON PEUT (Y compris le modèle brut et l'année brute)
    query_cars = f"""
        PREFIX : <http://www.univ-projet.fr/ontologies/autosemantic#>
        PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
        
        SELECT ?carURI ?label ?rawModel ?manufURI ?cylinders ?displacement ?transURI ?fuelURI
        WHERE {{
            ?carURI a :Car .
            
            OPTIONAL {{ ?carURI rdfs:label ?label }}
            OPTIONAL {{ ?carURI :modelName ?rawModel }}  # <--- NOUVEAU
            
            OPTIONAL {{ ?carURI :hasManufacturer ?manufURI }}
            OPTIONAL {{ ?carURI :numberOfCylinders ?cylinders }}
            OPTIONAL {{ ?carURI :engineDisplacement ?displacement }}
            OPTIONAL {{ ?carURI :hasTransmissionType ?transURI }}
            OPTIONAL {{ ?carURI :hasFuelType ?fuelURI }}
            
            {filter_clause}
        }}
        LIMIT 200
    """
    
    if st.button("Lancer la recherche"):
        results = g.query(query_cars)
        data = []
        for row in results:
            # --- INTELLIGENCE DE NOMMAGE ---
            # 1. On nettoie la marque (ex: "Mazda")
            marque_clean = clean_uri(row.manufURI)
            
            # 2. Si on a le label officiel du graphe, on le prend
            if row.label:
                nom_final = str(row.label)
            # 3. Sinon, on le CONSTRUIT NOUS-MÊME : "Marque Modèle"
            elif row.rawModel:
                # Si le modèle est "6", ça fera "Mazda 6"
                nom_final = f"{marque_clean} {row.rawModel}"
            # 4. Dernier recours : l'ID
            else:
                nom_final = f"Véhicule {str(row.carURI).split('/')[-1]}"

            data.append({
                "Modèle": nom_final,
                "Fabricant": marque_clean,
                "Cylindres": str(row.cylinders) if row.cylinders else "-",
                "Cylindrée": str(row.displacement) if row.displacement else "-",
                "Transmission": clean_uri(row.transURI),
                "Carburant": clean_uri(row.fuelURI)
            })
        
        if data:
            st.dataframe(pd.DataFrame(data), width='stretch')
        else:
            st.warning("Aucun résultat.")

with tab2:
    st.subheader("Top Fabricants (par Avis)")
    try:
        q_stats = """
            PREFIX : <http://www.univ-projet.fr/ontologies/autosemantic#>
            SELECT ?mURI (COUNT(?rev) as ?nb) WHERE {
                ?rev a :CustomerReview ; :isReviewOf ?v .
                ?v :hasManufacturer ?mURI .
            } GROUP BY ?mURI ORDER BY DESC(?nb) LIMIT 10
        """
        res = g.query(q_stats)
        st.bar_chart(pd.DataFrame([{"Fab": clean_uri(r.mURI), "Avis": int(r.nb)} for r in res]).set_index("Fab"))
    except: st.write("Pas de données.")