@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix : <http://www.univ-projet.fr/ontologies/autosemantica#> .
@base <http://www.univ-projet.fr/ontologies/autosemantica> .

# Mapping for vehicles
<#VehiclesCSVMap>
    a rr:TriplesMap ;

    rml:logicalSource [
        rml:source "data/vehicles_clean.csv" ;
        rml:referenceFormulation ql:CSV;
        rml:iterator "$"
    ] ;

    rr:subjectMap [
        rr:template "http://www.univ-projet.fr/ontologies/autosemantica/vehicle/{id}" ;
        rr:class :Vehicle 
    ] ;

    # Brand (make)
    rr:predicateObjectMap [
        rr:predicate :manufacturedBy ;
        rr:objectMap [ 
            rr:template "http://www.univ-projet.fr/ontologies/autosemantica/manufacturer/{make}" ;
        ]
    ] ;

    # Model (model)
    rr:predicateObjectMap [
        rr:predicate rdfs:label ;
        rr:objectMap [ rml:reference "model" ]
    ] ;

    # Year (year)
    rr:predicateObjectMap [
        rr:predicate :modelYear ;
        rr:objectMap [ rml:reference "year" ; rr:datatype xsd:integer ]
    ] ;

    # Fuel type (fuelType1)
    rr:predicateObjectMap [
        rr:predicate :hasFuelType ;
        rr:objectMap [ 
            rr:template "http://www.univ-projet.fr/ontologies/autosemantica/fuel/{fuelType1}" ;
        ]
    ] ;

    # Transmission (trany)
    rr:predicateObjectMap [
        rr:predicate :hasTransmissionType ;
        rr:objectMap [ 
            rr:template "http://www.univ-projet.fr/ontologies/autosemantica/transmission/{trany}" ;
        ]
    ] ;

    # Drive type (drive)
    rr:predicateObjectMap [
        rr:predicate :hasDriveType ;
        rr:objectMap [ 
            rr:template "http://www.univ-projet.fr/ontologies/autosemantica/drive/{drive}" ;
        ]
    ] ;

    # Body type (VClass)
    rr:predicateObjectMap [
        rr:predicate :hasBodyType ;
        rr:objectMap [ 
            rr:template "http://www.univ-projet.fr/ontologies/autosemantica/body/{VClass}" ;
        ]
    ] ;

    # CO2 emissions (co2TailpipeGpm)
    rr:predicateObjectMap [
        rr:predicate :co2Emission ;
        rr:objectMap [ rml:reference "co2TailpipeGpm" ; rr:datatype xsd:float ]
    ] ;

    # Number of cylinders (cylinders)
    rr:predicateObjectMap [
        rr:predicate :hasEngine ;
        rr:objectMap [ 
            rr:template "http://www.univ-projet.fr/ontologies/autosemantica/engine/{id}" ;
        ]
    ] ;

    # City consumption (city08)
    rr:predicateObjectMap [
        rr:predicate <http://www.univ-projet.fr/ontologies/autosemantica#cityConsumption> ;
        rr:objectMap [ rml:reference "city08" ; rr:datatype xsd:integer ]
    ] ;

    # Highway consumption (highway08)
    rr:predicateObjectMap [
        rr:predicate <http://www.univ-projet.fr/ontologies/autosemantica#highwayConsumption> ;
        rr:objectMap [ rml:reference "highway08" ; rr:datatype xsd:integer ]
    ] ;

    # Combined consumption (comb08)
    rr:predicateObjectMap [
        rr:predicate <http://www.univ-projet.fr/ontologies/autosemantica#combinedConsumption> ;
        rr:objectMap [ rml:reference "comb08" ; rr:datatype xsd:integer ]
    ] ;

    # Range (range)
    rr:predicateObjectMap [
        rr:predicate :range ;
        rr:objectMap [ rml:reference "range" ; rr:datatype xsd:integer ]
    ] ;

    # Fuel cost (fuelCost08)
    rr:predicateObjectMap [
        rr:predicate <http://www.univ-projet.fr/ontologies/autosemantica#fuelCost> ;
        rr:objectMap [ rml:reference "fuelCost08" ; rr:datatype xsd:integer ]
    ] .

# Mapping for engines
<#MotorsMap>
    a rr:TriplesMap ;

    rml:logicalSource [
        rml:source "data/vehicles_clean.csv" ;
        rml:referenceFormulation ql:CSV;
        rml:iterator "$"
    ] ;

    rr:subjectMap [
        rr:template "http://www.univ-projet.fr/ontologies/autosemantica/engine/{id}" ;
        rr:class :Engine 
    ] ;

    # Number of cylinders (cylinders)
    rr:predicateObjectMap [
        rr:predicate <http://www.univ-projet.fr/ontologies/autosemantica#cylinderCount> ;
        rr:objectMap [ rml:reference "cylinders" ; rr:datatype xsd:integer ]
    ] ;

    # Displacement (displ)
    rr:predicateObjectMap [
        rr:predicate <http://www.univ-projet.fr/ontologies/autosemantica#displacement> ;
        rr:objectMap [ rml:reference "displ" ; rr:datatype xsd:float ]
    ] ;

    # Engine description (eng_dscr)
    rr:predicateObjectMap [
        rr:predicate rdfs:label ;
        rr:objectMap [ rml:reference "eng_dscr" ]
    ] .

# Mapping for manufacturers
<#ManufacturersMap>
    a rr:TriplesMap ;

    rml:logicalSource [
        rml:source "data/vehicles_clean.csv" ;
        rml:referenceFormulation ql:CSV;
        rml:iterator "$"
    ] ;

    rr:subjectMap [
        rr:template "http://www.univ-projet.fr/ontologies/autosemantica/manufacturer/{make}" ;
        rr:class :Manufacturer 
    ] ;

    # Manufacturer name
    rr:predicateObjectMap [
        rr:predicate rdfs:label ;
        rr:objectMap [ rml:reference "make" ]
    ] .

# Mapping for customer reviews (consolidated_reviews.csv)
<#ReviewsCSVMap>
    a rr:TriplesMap ;

    rml:logicalSource [
        rml:source "data/consolidated_reviews_FINAL_clean.csv" ;
        rml:referenceFormulation ql:CSV;
        rml:iterator "$"
    ] ;

    rr:subjectMap [
        rr:template "http://www.univ-projet.fr/ontologies/autosemantica/review/{Unnamed: 0}" ;
        rr:class :CustomerReview 
    ] ;

    # Review date (Review_Date)
    rr:predicateObjectMap [
        rr:predicate <http://www.univ-projet.fr/ontologies/autosemantica#reviewDate> ;
        rr:objectMap [ rml:reference "Review_Date" ]
    ] ;

    # Review title (Review_Title)
    rr:predicateObjectMap [
        rr:predicate <http://www.univ-projet.fr/ontologies/autosemantica#reviewTitle> ;
        rr:objectMap [ rml:reference "Review_Title" ]
    ] ;

    # Review content (Review)
    rr:predicateObjectMap [
        rr:predicate <http://www.univ-projet.fr/ontologies/autosemantica#reviewContent> ;
        rr:objectMap [ rml:reference "Review" ]
    ] ;

    # Rating (Rating)
    rr:predicateObjectMap [
        rr:predicate :userRating ;
        rr:objectMap [ rml:reference "Rating" ; rr:datatype xsd:float ]
    ] ;

    # Concerned vehicle (Vehicle_Title)
    rr:predicateObjectMap [
        rr:predicate :concernsVehicle ;
        rr:objectMap [ 
            rr:template "http://www.univ-projet.fr/ontologies/autosemantica/vehicle/{Vehicle_Title}" ;
        ]
    ] ;

    # Review author (Author_Name)
    rr:predicateObjectMap [
        rr:predicate :hasWritten ;
        rr:objectMap [ 
            rr:parentTriplesMap <#UsersMap> ;
            rr:joinCondition [
                rr:child "Author_Name" ;
                rr:parent "Author_Name" ;
            ]
        ]
    ] .

# Mapping for users
<#UsersMap>
    a rr:TriplesMap ;

    rml:logicalSource [
        rml:source "data/consolidated_reviews_FINAL_clean.csv" ;
        rml:referenceFormulation ql:CSV;
        rml:iterator "$"
    ] ;

    rr:subjectMap [
        rr:template "http://www.univ-projet.fr/ontologies/autosemantica/user/{Author_Name}" ;
        rr:class :User 
    ] ;

    # User name
    rr:predicateObjectMap [
        rr:predicate rdfs:label ;
        rr:objectMap [ rml:reference "Author_Name" ]
    ] .
