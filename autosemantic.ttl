@prefix : <http://www.univ-projet.fr/ontologies/autosemantica#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@base <http://www.univ-projet.fr/ontologies/autosemantica> .

<http://www.univ-projet.fr/ontologies/autosemantica> rdf:type owl:Ontology ;
    rdfs:comment "Ontology for the AutoSemantic project"@en .

:Vehicle rdf:type owl:Class .

:Car rdf:type owl:Class ;
    rdfs:subClassOf :Vehicle .

:Motorcycle rdf:type owl:Class ;
    rdfs:subClassOf :Vehicle ;
    owl:disjointWith :Car .

:Manufacturer rdf:type owl:Class .
:AutomotiveGroup rdf:type owl:Class .
:Engine rdf:type owl:Class .
:Trim rdf:type owl:Class .
:CustomerReview rdf:type owl:Class .
:User rdf:type owl:Class .

:belongsToGroup rdf:type owl:ObjectProperty, owl:TransitiveProperty ;
    rdfs:domain :Manufacturer ;
    rdfs:range :AutomotiveGroup .

:isCompetitorOf rdf:type owl:ObjectProperty, owl:SymmetricProperty ;
    rdfs:domain :Car ;
    rdfs:range :Car .

:manufacturedBy rdf:type owl:ObjectProperty ;
    rdfs:domain :Vehicle ;
    rdfs:range :Manufacturer .

:hasEngine rdf:type owl:ObjectProperty ;
    rdfs:domain :Vehicle ;
    rdfs:range :Engine .

:hasWritten rdf:type owl:ObjectProperty ;
    rdfs:domain :User ;
    rdfs:range :CustomerReview .

:concernsVehicle rdf:type owl:ObjectProperty ;
    rdfs:domain :CustomerReview ;
    rdfs:range :Vehicle .

:hasBodyType rdf:type owl:ObjectProperty ;
    rdfs:domain :Car ;
    rdfs:range skos:Concept .

:hasTransmissionType rdf:type owl:ObjectProperty ;
    rdfs:domain :Vehicle ;
    rdfs:range skos:Concept .

:hasDriveType rdf:type owl:ObjectProperty ;
    rdfs:domain :Vehicle ;
    rdfs:range skos:Concept .

:hasFuelType rdf:type owl:ObjectProperty ;
    rdfs:domain :Vehicle ;
    rdfs:range skos:Concept .

:releaseYear rdf:type owl:DatatypeProperty ;
    rdfs:domain :Vehicle ;
    rdfs:range xsd:integer .

:modelYear rdf:type owl:DatatypeProperty ;
    rdfs:domain :Vehicle ;
    rdfs:range xsd:integer .

:phase rdf:type owl:DatatypeProperty ;
    rdfs:domain :Vehicle ;
    rdfs:range xsd:integer .

:averagePrice rdf:type owl:DatatypeProperty ;
    rdfs:domain :Vehicle ;
    rdfs:range xsd:float .

:co2Emission rdf:type owl:DatatypeProperty ;
    rdfs:domain :Vehicle ;
    rdfs:range xsd:integer .

:weight rdf:type owl:DatatypeProperty ;
    rdfs:domain :Vehicle ;
    rdfs:range xsd:integer ;
    rdfs:comment "Weight in kg of the vehicle."@en .

:range rdf:type owl:DatatypeProperty ;
    rdfs:domain :Vehicle ;
    rdfs:range xsd:integer .

:userRating rdf:type owl:DatatypeProperty ;
    rdfs:domain :CustomerReview ;
    rdfs:range xsd:integer .

:power rdf:type owl:DatatypeProperty ;
    rdfs:domain :Engine ;
    rdfs:range xsd:integer .

:torque rdf:type owl:DatatypeProperty ;
    rdfs:domain :Engine ;
    rdfs:range xsd:integer .

:seatCount rdf:type owl:DatatypeProperty ;
    rdfs:domain :Vehicle ;
    rdfs:range xsd:integer .

:doorCount rdf:type owl:DatatypeProperty ;
    rdfs:domain :Car ;
    rdfs:range xsd:integer .

:trunkVolume rdf:type owl:DatatypeProperty ;
    rdfs:domain :Car ;
    rdfs:range xsd:integer .

:aspirationType rdf:type owl:DatatypeProperty ;
    rdfs:domain :Engine ;
    rdfs:range xsd:string .

:PollutingCar rdf:type owl:Class ;
    owl:equivalentClass [
        rdf:type owl:Class ;
        owl:intersectionOf (
            :Car
            [
                rdf:type owl:Restriction ;
                owl:onProperty :co2Emission ;
                owl:someValuesFrom [
                    rdf:type rdfs:Datatype ;
                    owl:onDatatype xsd:integer ;
                    owl:withRestrictions ( [ xsd:minExclusive 140 ] )
                ]
            ]
        )
    ] .

:FuelType rdf:type skos:ConceptScheme .

:Diesel rdf:type skos:Concept ;
    skos:inScheme :FuelType ;
    skos:prefLabel "Diesel"@en .

:Gasoline rdf:type skos:Concept ;
    skos:inScheme :FuelType ;
    skos:prefLabel "Gasoline"@en .

:Hybrid rdf:type skos:Concept ;
    skos:inScheme :FuelType ;
    skos:prefLabel "Hybrid"@en .

:PHEV rdf:type skos:Concept ;
    skos:broader :Hybrid ;
    skos:inScheme :FuelType ;
    skos:prefLabel "Plug-in Hybrid"@en .

:BodyType rdf:type skos:ConceptScheme .

:SUV rdf:type skos:Concept ;
    skos:inScheme :BodyType ;
    skos:prefLabel "SUV"@en .

:Coupe rdf:type skos:Concept ;
    skos:inScheme :BodyType ;
    skos:prefLabel "Coupe"@en .

:Sedan rdf:type skos:Concept ;
    skos:inScheme :BodyType ;
    skos:prefLabel "Sedan"@en .

:TransmissionType rdf:type skos:ConceptScheme .

:Manual rdf:type skos:Concept ;
    skos:inScheme :TransmissionType ;
    skos:prefLabel "Manual Transmission"@en ;
    skos:altLabel "Manual Gearbox"@en .

:Sequential rdf:type skos:Concept ;
    skos:inScheme :TransmissionType ;
    skos:prefLabel "Sequential"@en .

:Automatic rdf:type skos:Concept ;
    skos:inScheme :TransmissionType ;
    skos:prefLabel "Automatic"@en .

:DriveType rdf:type skos:ConceptScheme .

:FrontWheelDrive rdf:type skos:Concept ;
    skos:inScheme :DriveType ;
    skos:prefLabel "Front-wheel Drive"@en .

:RearWheelDrive rdf:type skos:Concept ;
    skos:inScheme :DriveType ;
    skos:prefLabel "Rear-wheel Drive"@en .

:AllWheelDrive rdf:type skos:Concept ;
    skos:inScheme :DriveType ;
    skos:prefLabel "4-wheel Drive"@en ;
    skos:altLabel "4WD"@en, "AWD"@en .