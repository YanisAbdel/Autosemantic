@prefix : <http://www.univ-projet.fr/ontologies/autosemantica#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@base <http://www.univ-projet.fr/ontologies/autosemantica> .

<http://www.univ-projet.fr/ontologies/autosemantica> rdf:type owl:Ontology ;
    rdfs:comment "Ontologie pour le projet AutoSemantic : Véhicules et Avis Clients"@fr .

#################################################################
#    Classes
#################################################################

:Vehicle rdf:type owl:Class ;
    rdfs:label "Véhicule"@fr .

:Car rdf:type owl:Class ;
    rdfs:subClassOf :Vehicle ;
    rdfs:label "Voiture"@fr ;
    rdfs:comment "Représente une entrée du fichier vehicles.csv"@fr .

:Manufacturer rdf:type owl:Class ;
    rdfs:label "Constructeur"@fr ;
    rdfs:comment "Ex: Ford, Dodge, Ferrari..."@fr .

:CustomerReview rdf:type owl:Class ;
    rdfs:label "Avis Client"@fr ;
    rdfs:comment "Représente une ligne du fichier reviews_final.csv"@fr .

:User rdf:type owl:Class ;
    rdfs:subClassOf foaf:Person ;
    rdfs:label "Utilisateur"@fr .

#################################################################
#    Object Properties
#################################################################

### Liens Voiture -> Constructeur
:manufacturedBy rdf:type owl:ObjectProperty ;
    rdfs:domain :Car ;
    rdfs:range :Manufacturer ;
    rdfs:label "Construit par"@fr .

### Liens Avis -> Voiture
:isReviewOf rdf:type owl:ObjectProperty ;
    rdfs:domain :CustomerReview ;
    rdfs:range :Car ;
    rdfs:label "Concerne le véhicule"@fr .

### Liens Avis -> Utilisateur
:writtenBy rdf:type owl:ObjectProperty ;
    rdfs:domain :CustomerReview ;
    rdfs:range :User ;
    rdfs:label "Écrit par"@fr .

### Liens vers les Thésaurus SKOS
:hasTransmission rdf:type owl:ObjectProperty ;
    rdfs:domain :Car ;
    rdfs:range skos:Concept ;
    rdfs:label "Type de transmission"@fr .

:hasDriveTrain rdf:type owl:ObjectProperty ;
    rdfs:domain :Car ;
    rdfs:range skos:Concept ;
    rdfs:label "Transmission (Roues motrices)"@fr .

:hasVehicleClass rdf:type owl:ObjectProperty ;
    rdfs:domain :Car ;
    rdfs:range skos:Concept ;
    rdfs:label "Catégorie de véhicule"@fr .

:hasFuelType rdf:type owl:ObjectProperty ;
    rdfs:domain :Car ;
    rdfs:range skos:Concept ;
    rdfs:label "Type de carburant"@fr .

#################################################################
#    Datatype Properties
#################################################################

### Propriétés pour :Car
:modelName rdf:type owl:DatatypeProperty ;
    rdfs:domain :Car ;
    rdfs:range xsd:string ;
    rdfs:label "Nom du modèle"@fr .

:year rdf:type owl:DatatypeProperty ;
    rdfs:domain :Car ;
    rdfs:range xsd:integer ;
    rdfs:label "Année de production"@fr .

:numberOfCylinders rdf:type owl:DatatypeProperty ;
    rdfs:domain :Car ;
    rdfs:range xsd:integer ;
    rdfs:label "Nombre de cylindres"@fr .

:engineDisplacement rdf:type owl:DatatypeProperty ;
    rdfs:domain :Car ;
    rdfs:range xsd:float ;
    rdfs:label "Cylindrée (L)"@fr .

:cityMPG rdf:type owl:DatatypeProperty ;
    rdfs:domain :Car ;
    rdfs:range xsd:float ;
    rdfs:label "Conso Ville (MPG)"@fr .

:highwayMPG rdf:type owl:DatatypeProperty ;
    rdfs:domain :Car ;
    rdfs:range xsd:float ;
    rdfs:label "Conso Autoroute (MPG)"@fr .

:combinedMPG rdf:type owl:DatatypeProperty ;
    rdfs:domain :Car ;
    rdfs:range xsd:float ;
    rdfs:label "Conso Mixte (MPG)"@fr .

:co2Emissions rdf:type owl:DatatypeProperty ;
    rdfs:domain :Car ;
    rdfs:range xsd:float ;
    rdfs:label "Émissions CO2 (g/mile)"@fr .

### Propriétés pour :CustomerReview (issues de reviews_final.csv)
:reviewBody rdf:type owl:DatatypeProperty ;
    rdfs:domain :CustomerReview ;
    rdfs:range xsd:string ;
    rdfs:label "Contenu de l'avis"@fr .

:reviewTitle rdf:type owl:DatatypeProperty ;
    rdfs:domain :CustomerReview ;
    rdfs:range xsd:string ;
    rdfs:label "Titre de l'avis"@fr .

:reviewRating rdf:type owl:DatatypeProperty ;
    rdfs:domain :CustomerReview ;
    rdfs:range xsd:float ;
    rdfs:label "Note (sur 5)"@fr .

:reviewDate rdf:type owl:DatatypeProperty ;
    rdfs:domain :CustomerReview ;
    rdfs:range xsd:date ;
    rdfs:label "Date de l'avis"@fr .

### Propriétés pour :User et :Manufacturer
:name rdf:type owl:DatatypeProperty ;
    rdfs:domain [ owl:unionOf (:User :Manufacturer) ] ;
    rdfs:range xsd:string ;
    rdfs:label "Nom"@fr .

#################################################################
#    Système SKOS
#################################################################

:TransmissionType rdf:type skos:ConceptScheme ;
    skos:prefLabel "Type de Transmission"@fr .

:Automatic rdf:type skos:Concept ;
    skos:inScheme :TransmissionType ;
    skos:prefLabel "Automatique"@fr ;
    skos:altLabel "Automatic"@en .

:Manual rdf:type skos:Concept ;
    skos:inScheme :TransmissionType ;
    skos:prefLabel "Manuelle"@fr ;
    skos:altLabel "Manual"@en .

:CVT rdf:type skos:Concept ;
    skos:inScheme :TransmissionType ;
    skos:prefLabel "CVT"@fr .

:FuelTypeScheme rdf:type skos:ConceptScheme ;
    skos:prefLabel "Type de Carburant"@fr .

:VehicleClassScheme rdf:type skos:ConceptScheme ;
    skos:prefLabel "Catégorie de Véhicule"@fr .