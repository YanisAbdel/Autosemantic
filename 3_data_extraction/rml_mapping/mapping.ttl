@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix : <http://www.univ-projet.fr/ontologies/autosemantic#> .
@base <http://www.univ-projet.fr/ontologies/autosemantic> .

#################################################################
#    Mapping des Véhicules (vehicles_clean.csv)
#################################################################

<#VehiclesMap>
    a rr:TriplesMap ;

    rml:logicalSource [
        rml:source "/data/2_data_sources/structured/vehicles_clean.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;

    rr:subjectMap [
        rr:template "http://www.univ-projet.fr/ontologies/autosemantic#/vehicle/{id}" ;
        rr:class :Car
    ] ;

    # Label (modèle + année)
    rr:predicateObjectMap [
        rr:predicate rdfs:label ;
        rr:objectMap [ 
            rr:template "{year} {make} {model}" 
        ]
    ] ;

    # SAUVEGARDE DE SECOURS DU NOM DU MODÈLE
    rr:predicateObjectMap [
        rr:predicate :modelName ;
        rr:objectMap [ 
            rml:reference "model" ;
            rr:datatype xsd:string
        ]
    ] ;

    # Fabricant (hasManufacturer) -> Concept SKOS
    rr:predicateObjectMap [
        rr:predicate :hasManufacturer ;
        rr:objectMap [ 
            rr:template "http://www.univ-projet.fr/ontologies/autosemantic#{make}" ;
            rr:termType rr:IRI
        ]
    ] ;

    # Nombre de cylindres (numberOfCylinders)
    rr:predicateObjectMap [
        rr:predicate :numberOfCylinders ;
        rr:objectMap [ 
            rml:reference "cylinders" ; 
            rr:datatype xsd:float 
        ]
    ] ;

    # Cylindrée (engineDisplacement)
    rr:predicateObjectMap [
        rr:predicate :engineDisplacement ;
        rr:objectMap [ 
            rml:reference "displ" ; 
            rr:datatype xsd:float 
        ]
    ] ;

    # Type de transmission (hasTransmissionType) -> Concept SKOS
    rr:predicateObjectMap [
        rr:predicate :hasTransmissionType ;
        rr:objectMap [ 
            rr:template "http://www.univ-projet.fr/ontologies/autosemantic#{trany}" ;
            rr:termType rr:IRI
        ]
    ] ;

    # Type de motricité (hasDriveType) -> Concept SKOS
    rr:predicateObjectMap [
        rr:predicate :hasDriveType ;
        rr:objectMap [ 
            rr:template "http://www.univ-projet.fr/ontologies/autosemantic#{drive}" ;
            rr:termType rr:IRI
        ]
    ] ;

    # Type de carburant (hasFuelType) -> Concept SKOS
    rr:predicateObjectMap [
        rr:predicate :hasFuelType ;
        rr:objectMap [ 
            rr:template "http://www.univ-projet.fr/ontologies/autosemantic#{fuelType}" ;
            rr:termType rr:IRI
        ]
    ] ;

    # Classe de véhicule (hasVehicleClass) -> Concept SKOS
    rr:predicateObjectMap [
        rr:predicate :hasVehicleClass ;
        rr:objectMap [ 
            rr:template "http://www.univ-projet.fr/ontologies/autosemantic#{VClass}" ;
            rr:termType rr:IRI
        ]
    ] ;

    # CO2 Emissions (co2)
    rr:predicateObjectMap [
        rr:predicate :co2Emissions ;
        rr:objectMap [ 
            rml:reference "co2" ; 
            rr:datatype xsd:float 
        ]
    ] ;

    # City MPG (city08)
    rr:predicateObjectMap [
        rr:predicate :mpgCity ;
        rr:objectMap [ 
            rml:reference "city08" ; 
            rr:datatype xsd:float 
        ]
    ] ;

    # City Electricity Consumption (cityE)
    rr:predicateObjectMap [
        rr:predicate :cityElectricityConsumption ;
        rr:objectMap [ 
            rml:reference "cityE" ; 
            rr:datatype xsd:float 
        ]
    ] ;

    # Highway MPG (highway08)
    rr:predicateObjectMap [
        rr:predicate :mpgHighway ;
        rr:objectMap [ 
            rml:reference "highway08" ; 
            rr:datatype xsd:float 
        ]
    ] ;

    # Highway Electricity Consumption (highwayE)
    rr:predicateObjectMap [
        rr:predicate :highwayElectricityConsumption ;
        rr:objectMap [
            rml:reference "highwayE" ; 
            rr:datatype xsd:float 
        ]
    ] ;

    # Base Model (baseModel)
    rr:predicateObjectMap [
        rr:predicate :baseModel ;
        rr:objectMap [ 
            rml:reference "baseModel" ; 
            rr:datatype xsd:string 
        ]
    ] ;

    # Transmission Description (trans_dscr)
    rr:predicateObjectMap [
        rr:predicate :transmissionDescription ;
        rr:objectMap [ 
            rml:reference "trans_dscr" ; 
            rr:datatype xsd:string 
        ]
    ] .

#################################################################
#    Mapping des Avis Clients (reviews_final_clean.csv)
#################################################################

<#ReviewsMap>
    a rr:TriplesMap ;

    rml:logicalSource [
        rml:source "/data/2_data_sources/structured/reviews_final_clean.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;

    rr:subjectMap [
        rr:template "http://www.univ-projet.fr/ontologies/autosemantic#/review/{Brand}_{Review_Year}_{Rating}" ;
        rr:class :CustomerReview
    ] ;

    # Contenu de l'avis (reviewContent)
    rr:predicateObjectMap [
        rr:predicate :reviewContent ;
        rr:objectMap [ 
            rml:reference "Review" ;
            rr:datatype xsd:string
        ]
    ] ;

    # Note de l'avis (reviewRating)
    rr:predicateObjectMap [
        rr:predicate :reviewRating ;
        rr:objectMap [ 
            rml:reference "Rating" ; 
            rr:datatype xsd:decimal 
        ]
    ] ;

    # Relation avec le véhicule (isReviewOf)
    rr:predicateObjectMap [
        rr:predicate :isReviewOf ;
        rr:objectMap [
            rr:parentTriplesMap <#VehiclesMap> ;
            rr:joinCondition [
                rr:child "Brand" ;
                rr:parent "make"
            ] ;
            rr:joinCondition [
                rr:child "Review_Year" ;
                rr:parent "year"
            ] ;
            rr:joinCondition [
                rr:child "Review_Model_Base" ;
                rr:parent "model"
            ]
        ]
    ] .

# =============================================
# Mapping pour les Manufacturers (Fabricants)
# =============================================
<#ManufacturersMap>
    rml:logicalSource [
        rml:source "../../2_data_sources/structured/vehicles_clean.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;

    rr:subjectMap [
        rr:template "http://www.univ-projet.fr/ontologies/autosemantic#{make}" ;
        rr:class :Manufacturer
    ] ;

    # Label du fabricant
    rr:predicateObjectMap [
        rr:predicate rdfs:label ;
        rr:objectMap [ 
            rml:reference "make" ; 
            rr:datatype xsd:string
        ]
    ] .
