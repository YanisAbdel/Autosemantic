@prefix auto: <http://www.univ-projet.fr/ontologies/autosemantic#> .
@prefix dbo: <http://dbpedia.org/ontology/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix schema: <https://schema.org/> .

auto:Car owl:equivalentClass dbo:Automobile,
        schema:Car .

auto:CustomerReview owl:equivalentClass schema:Review .

auto:Manufacturer owl:equivalentClass dbo:Company,
        schema:Brand,
        schema:Organization .

auto:Vehicle owl:equivalentClass dbo:MeanOfTransportation,
        schema:Vehicle .

auto:engineDisplacement owl:equivalentProperty dbo:displacement .

auto:hasFuelType owl:equivalentProperty schema:fuelType .

auto:hasManufacturer owl:equivalentProperty dbo:manufacturer,
        schema:manufacturer .

auto:hasTransmissionType owl:equivalentProperty schema:vehicleTransmission .

auto:numberOfCylinders owl:equivalentProperty dbo:numberOfCylinders .

auto:reviewContent owl:equivalentProperty schema:reviewBody .

auto:reviewDate owl:equivalentProperty schema:datePublished .

auto:reviewRating owl:equivalentProperty schema:ratingValue .

