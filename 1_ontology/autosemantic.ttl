@prefix : <http://www.univ-projet.fr/ontologies/autosemantic#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct: <http://purl.org/dc/terms/> .
@base <http://www.univ-projet.fr/ontologies/autosemantic#> .

<http://www.univ-projet.fr/ontologies/autosemantic> rdf:type owl:Ontology ;
    rdfs:comment "Ontologie enrichie pour le projet AutoSemantic."@fr .

:manufactures rdf:type owl:ObjectProperty ;
              owl:inverseOf :hasManufacturer ;
              rdfs:domain :Manufacturer ;
              rdfs:range :Vehicle ;
              rdfs:label "fabrique"@fr .

:hasManufacturer rdf:type owl:ObjectProperty ;
                 rdfs:domain :Vehicle ;
                 rdfs:range :Manufacturer ;
                 rdfs:label "a pour fabricant"@fr .

:hasReview rdf:type owl:ObjectProperty ;
           owl:inverseOf :isReviewOf ;
           rdfs:domain :Vehicle ;
           rdfs:range :CustomerReview ;
           rdfs:label "a pour avis"@fr .

:isReviewOf rdf:type owl:ObjectProperty ;
            rdfs:domain :CustomerReview ;
            rdfs:range :Vehicle ;
            rdfs:label "est un avis sur"@fr .

:hasTransmissionType rdf:type owl:ObjectProperty ;
                     rdfs:range skos:Concept ;
                     rdfs:comment "Lié au Concept Scheme Transmission"@fr .

:hasDriveType rdf:type owl:ObjectProperty ;
              rdfs:range skos:Concept ;
              rdfs:comment "Lié au Concept Scheme DriveType (ex: 4WD, FWD)"@fr .

:hasFuelType rdf:type owl:ObjectProperty ;
             rdfs:range skos:Concept .

:isProductOfGroup rdf:type owl:ObjectProperty ;
                  owl:propertyChainAxiom ( :hasManufacturer skos:broader ) ;
                  rdfs:label "est un produit du groupe"@fr .


:modelYear rdf:type owl:DatatypeProperty ;
    rdfs:domain :Vehicle ;
    rdfs:range xsd:integer .

:numberOfCylinders rdf:type owl:DatatypeProperty ;
                   rdfs:domain :Vehicle ;
                   rdfs:range xsd:integer .

:numberOfGears rdf:type owl:DatatypeProperty ;
               rdfs:domain :Vehicle ;
               rdfs:range xsd:integer ;
               rdfs:comment "Nombre de rapports de la boîte de vitesses"@fr .

:engineDisplacement rdf:type owl:DatatypeProperty ;
                    rdfs:domain :Vehicle ;
                    rdfs:range xsd:float ;
                    rdfs:comment "Cylindrée en litres"@fr .

:fuelConsumptionCity rdf:type owl:DatatypeProperty ;
    rdfs:domain :Vehicle ;
    rdfs:range xsd:float ;
    rdfs:comment "Consommation ville en galons/100mi"@fr .

:fuelConsumptionHighway rdf:type owl:DatatypeProperty ;
    rdfs:domain :Vehicle ;
    rdfs:range xsd:float ;
    rdfs:comment "Consommation autoroute en galons/100mi"@fr .

:electricConsumptionCity rdf:type owl:DatatypeProperty ;
    rdfs:domain :Vehicle ;
    rdfs:range xsd:float ;
    rdfs:comment "Consommation électrique ville en kWh/100mi"@fr .

:electricConsumptionHighway rdf:type owl:DatatypeProperty ;
    rdfs:domain :Vehicle ;
    rdfs:range xsd:float ;
    rdfs:comment "Consommation électrique autoroute en kWh/100mi"@fr .

:reviewRating rdf:type owl:DatatypeProperty ;
              rdfs:domain :CustomerReview ;
              rdfs:range xsd:decimal .

:reviewContent rdf:type owl:DatatypeProperty ;
               rdfs:domain :CustomerReview ;
               rdfs:range xsd:string .

:reviewDate rdf:type owl:DatatypeProperty ;
            rdfs:domain :CustomerReview ;
            rdfs:range xsd:date .


:Vehicle rdf:type owl:Class .

:Car rdf:type owl:Class ;
     rdfs:subClassOf :Vehicle .

:Manufacturer rdf:type owl:Class .

:CustomerReview rdf:type owl:Class ;
                rdfs:comment "Avis utilisateur extrait de reviews_sample.csv"@fr .



:HighPerformanceCar rdf:type owl:Class ;
                    owl:equivalentClass [ owl:intersectionOf ( :Car
                                          [ rdf:type owl:Class ;
                                            owl:unionOf ( [ rdf:type owl:Restriction ;
                                                            owl:onProperty :engineDisplacement ;
                                                            owl:minInclusive "4.0"^^xsd:float ]
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty :numberOfCylinders ;
                                                            owl:minInclusive 6 ]
                                                        ) ]
                                          [ rdf:type owl:Class ;
                                            owl:complementOf [ rdf:type owl:Restriction ;
                                                               owl:onProperty :hasVehicleClass ;
                                                               owl:someValuesFrom [ rdf:type owl:Class ;
                                                                                    owl:oneOf ( :VanClass :Minivan :PassengerVan :CargoVan ) ]
                                                             ]
                                          ]
                                          ) ] .

:CityCar rdf:type owl:Class ;
         owl:equivalentClass [ owl:intersectionOf ( :Car
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :fuelConsumptionCity ;
                                 owl:maxInclusive "9.4"^^xsd:float ]
                               [ rdf:type owl:Class ;
                                 owl:unionOf ( [ rdf:type owl:Restriction ;
                                                 owl:onProperty :hasVehicleClass ;
                                                 owl:hasValue :CompactCar ]
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty :hasVehicleClass ;
                                                 owl:hasValue :SubcompactCar ]
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty :hasVehicleClass ;
                                                 owl:hasValue :MinicompactCar ]
                                             ) ]
                             ) ] .

:GasGuzzler rdf:type owl:Class ;
            owl:equivalentClass [ owl:intersectionOf ( :Car
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :fuelConsumptionCity ;
                                    owl:minExclusive "15.7"^^xsd:float ]
                                ) ] .

:LuxuryManufacturer rdf:type owl:Class ;
                    rdfs:subClassOf :Manufacturer ;
                    owl:oneOf ( :Ferrari :Bentley :RollsRoyce :Lamborghini :Maserati :AstonMartin :Bugatti :McLarenAutomotive :Porsche ) .

:LuxuryVehicle rdf:type owl:Class ;
               owl:equivalentClass [ owl:intersectionOf ( :Vehicle
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty :hasManufacturer ;
                                       owl:someValuesFrom :LuxuryManufacturer ]
                                   ) ] .

:OffRoadVehicle rdf:type owl:Class ;
                owl:equivalentClass [ owl:intersectionOf ( :Vehicle
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty :hasVehicleClass ;
                                        owl:someValuesFrom [ rdf:type owl:Class ;
                                                             owl:oneOf ( :TruckClass :PickupTruck :SmallPickupTruck :StandardPickupTruck 
                                                                         :SUVClass :SmallSUV :StandardSUV ) ]
                                      ]
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty :hasDriveType ;
                                        owl:someValuesFrom [ rdf:type owl:Class ;
                                                             owl:oneOf ( :FourWheelDrive :PartTimeFourWheelDrive :AllWheelDrive :FourWheelOrAllWheelDrive ) ]
                                      ]
                                    ) ] .

:RoadTripReady rdf:type owl:Class ;
               owl:equivalentClass [ owl:intersectionOf ( :Car
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty :fuelConsumptionHighway ;
                                       owl:maxExclusive "7.8"^^xsd:float ]
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty :hasVehicleClass ;
                                       owl:someValuesFrom [ rdf:type owl:Class ;
                                                            owl:oneOf ( :MidsizeCar :LargeCar :MidsizeStationWagon :MidsizeLargeStationWagon ) ]
                                     ]
                                   ) ] .

:PositiveReview rdf:type owl:Class ;
                owl:equivalentClass [ owl:intersectionOf ( :CustomerReview
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty :reviewRating ;
                                        owl:minInclusive "4.0"^^xsd:decimal ]
                                    ) ] .

:CriticalReview rdf:type owl:Class ;
                owl:equivalentClass [ owl:intersectionOf ( :CustomerReview
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty :reviewRating ;
                                        owl:maxInclusive "2.0"^^xsd:decimal ]
                                    ) ] .


:TransmissionScheme rdf:type skos:ConceptScheme ;
                    skos:prefLabel "Type de Transmission"@fr .

:Automatic rdf:type skos:Concept ;
           skos:inScheme :TransmissionScheme ;
           skos:prefLabel "Automatic"@en ;
           skos:prefLabel "Automatique"@fr .

:Manual rdf:type skos:Concept ;
        skos:inScheme :TransmissionScheme ;
        skos:prefLabel "Manual"@en ;
        skos:prefLabel "Manuelle"@fr .

:AutomatedManual rdf:type skos:Concept ;
                 skos:inScheme :TransmissionScheme ;
                 skos:broader :Automatic ;
                 skos:prefLabel "Automated Manual"@en ;
                 skos:prefLabel "Manuelle Robotisée"@fr .

:CVT rdf:type skos:Concept ;
     skos:inScheme :TransmissionScheme ;
     skos:broader :Automatic ;
     skos:prefLabel "CVT (Continuously Variable Transmission)"@en .

:DualClutch rdf:type skos:Concept ;
            skos:inScheme :TransmissionScheme ;
            skos:broader :AutomatedManual ;
            skos:prefLabel "Dual Clutch Transmission (DCT)"@en .

:DriveTypeScheme rdf:type skos:ConceptScheme .

:TwoWheelDrive rdf:type skos:Concept ;
               skos:inScheme :DriveTypeScheme ;
               skos:prefLabel "2-Wheel Drive"@en .

:FrontWheelDrive rdf:type skos:Concept ;
                 skos:inScheme :DriveTypeScheme ;
                 skos:broader :TwoWheelDrive ;
                 skos:prefLabel "Front-Wheel Drive"@en .

:RearWheelDrive rdf:type skos:Concept ;
                skos:inScheme :DriveTypeScheme ;
                skos:broader :TwoWheelDrive ;
                skos:prefLabel "Rear-Wheel Drive"@en .

:FourWheelDrive rdf:type skos:Concept ;
                skos:inScheme :DriveTypeScheme ;
                skos:prefLabel "4-Wheel Drive"@en .

:PartTimeFourWheelDrive rdf:type skos:Concept ;
                        skos:inScheme :DriveTypeScheme ;
                        skos:broader :FourWheelDrive ;
                        skos:prefLabel "Part-time 4-Wheel Drive"@en .

:AllWheelDrive rdf:type skos:Concept ;
               skos:inScheme :DriveTypeScheme ;
               skos:prefLabel "All-Wheel Drive"@en .

:FourWheelOrAllWheelDrive rdf:type skos:Concept ;
                          skos:inScheme :DriveTypeScheme ;
                          skos:prefLabel "4-Wheel or All-Wheel Drive"@en .

:FuelTypeScheme rdf:type skos:ConceptScheme ;
                skos:prefLabel "Type de Carburant"@fr .

:FossilFuel rdf:type skos:Concept ;
            skos:inScheme :FuelTypeScheme ;
            skos:prefLabel "Fossil Fuel"@en ;
            skos:prefLabel "Carburant Fossile"@fr .

:CleanEnergy rdf:type skos:Concept ;
             skos:inScheme :FuelTypeScheme ;
             skos:prefLabel "Clean Energy"@en ;
             skos:prefLabel "Energie Propre"@fr .

:Gasoline rdf:type skos:Concept ;
          skos:broader :FossilFuel ;
          skos:inScheme :FuelTypeScheme ;
          skos:prefLabel "Gasoline"@en ;
          skos:prefLabel "Essence"@fr .

:Diesel rdf:type skos:Concept ;
        skos:broader :FossilFuel ;
        skos:inScheme :FuelTypeScheme ;
        skos:prefLabel "Diesel"@en ;
        skos:prefLabel "Diesel"@fr .

:CNG rdf:type skos:Concept ;
     skos:broader :FossilFuel ;
     skos:inScheme :FuelTypeScheme ;
     skos:prefLabel "CNG"@en ;
     skos:altLabel "Compressed Natural Gas"@en .

:Propane rdf:type skos:Concept ;
         skos:broader :FossilFuel ;
         skos:inScheme :FuelTypeScheme ;
         skos:prefLabel "Propane"@en .

:Electricity rdf:type skos:Concept ;
             skos:broader :CleanEnergy ;
             skos:inScheme :FuelTypeScheme ;
             skos:prefLabel "Electricity"@en ;
             skos:prefLabel "Electricité"@fr .

:Hydrogen rdf:type skos:Concept ;
          skos:broader :CleanEnergy ;
          skos:inScheme :FuelTypeScheme ;
          skos:prefLabel "Hydrogen"@en .

:Regular rdf:type skos:Concept ;
         skos:broader :Gasoline ;
         skos:inScheme :FuelTypeScheme ;
         skos:prefLabel "Regular Gasoline"@en .

:Midgrade rdf:type skos:Concept ;
          skos:broader :Gasoline ;
          skos:inScheme :FuelTypeScheme ;
          skos:prefLabel "Midgrade Gasoline"@en .

:Premium rdf:type skos:Concept ;
         skos:broader :Gasoline ;
         skos:inScheme :FuelTypeScheme ;
         skos:prefLabel "Premium Gasoline"@en .

:GasolineOrE85 rdf:type skos:Concept ;
               skos:broader :Gasoline ;
               skos:inScheme :FuelTypeScheme ;
               skos:prefLabel "Gasoline or E85"@en .

:GasolineOrNaturalGas rdf:type skos:Concept ;
                      skos:broader :Gasoline, :CNG ;
                      skos:inScheme :FuelTypeScheme ;
                      skos:prefLabel "Gasoline or Natural Gas"@en .

:GasolineOrPropane rdf:type skos:Concept ;
                   skos:broader :Gasoline, :Propane ;
                   skos:inScheme :FuelTypeScheme ;
                   skos:prefLabel "Gasoline or Propane"@en .

:PremiumGasOrElectricity rdf:type skos:Concept ;
                         skos:broader :Premium, :Electricity ;
                         skos:inScheme :FuelTypeScheme ;
                         skos:prefLabel "Premium Gas or Electricity"@en .

:PremiumAndElectricity rdf:type skos:Concept ;
                       skos:broader :Premium, :Electricity ;
                       skos:inScheme :FuelTypeScheme ;
                       skos:prefLabel "Premium and Electricity"@en .

:PremiumOrE85 rdf:type skos:Concept ;
              skos:broader :Premium ;
              skos:inScheme :FuelTypeScheme ;
              skos:prefLabel "Premium or E85"@en .

:RegularGasAndElectricity rdf:type skos:Concept ;
                          skos:broader :Regular, :Electricity ;
                          skos:inScheme :FuelTypeScheme ;
                          skos:prefLabel "Regular Gas and Electricity"@en .

:RegularGasOrElectricity rdf:type skos:Concept ;
                         skos:broader :Regular, :Electricity ;
                         skos:inScheme :FuelTypeScheme ;
                         skos:prefLabel "Regular Gas or Electricity"@en .

:VehicleClassScheme rdf:type skos:ConceptScheme ;
                    skos:prefLabel "Classe de véhicule"@fr .

:hasVehicleClass rdf:type owl:ObjectProperty ;
                 rdfs:range skos:Concept ;
                 rdfs:comment "Lié au Concept Scheme VehicleClass"@fr .

:CarClass rdf:type skos:Concept ;
          skos:inScheme :VehicleClassScheme ;
          skos:prefLabel "Car"@en ;
          skos:prefLabel "Voiture"@fr .

:TruckClass rdf:type skos:Concept ;
            skos:inScheme :VehicleClassScheme ;
            skos:prefLabel "Truck"@en ;
            skos:prefLabel "Camion"@fr .

:VanClass rdf:type skos:Concept ;
          skos:inScheme :VehicleClassScheme ;
          skos:prefLabel "Van"@en ;
          skos:prefLabel "Fourgon / Van"@fr .

:SUVClass rdf:type skos:Concept ;
          skos:inScheme :VehicleClassScheme ;
          skos:prefLabel "Sport Utility Vehicle"@en ;
          skos:prefLabel "SUV"@fr .

:SpecialPurposeClass rdf:type skos:Concept ;
                     skos:inScheme :VehicleClassScheme ;
                     skos:prefLabel "Special Purpose Vehicle"@en .

:StationWagonClass rdf:type skos:Concept ;
                   skos:inScheme :VehicleClassScheme ;
                   skos:prefLabel "Station Wagon"@en ;
                   skos:prefLabel "Break"@fr .

:CompactCar rdf:type skos:Concept ;
            skos:broader :CarClass ;
            skos:inScheme :VehicleClassScheme ;
            skos:prefLabel "Compact Car"@en .

:SubcompactCar rdf:type skos:Concept ;
               skos:broader :CarClass ;
               skos:inScheme :VehicleClassScheme ;
               skos:prefLabel "Subcompact Car"@en .

:MinicompactCar rdf:type skos:Concept ;
                skos:broader :CarClass ;
                skos:inScheme :VehicleClassScheme ;
                skos:prefLabel "Minicompact Car"@en .

:MidsizeCar rdf:type skos:Concept ;
            skos:broader :CarClass ;
            skos:inScheme :VehicleClassScheme ;
            skos:prefLabel "Midsize Car"@en .

:LargeCar rdf:type skos:Concept ;
          skos:broader :CarClass ;
          skos:inScheme :VehicleClassScheme ;
          skos:prefLabel "Large Car"@en .

:TwoSeater rdf:type skos:Concept ;
           skos:broader :CarClass ;
           skos:inScheme :VehicleClassScheme ;
           skos:prefLabel "Two Seater"@en .

:SmallStationWagon rdf:type skos:Concept ;
                   skos:broader :StationWagonClass ;
                   skos:inScheme :VehicleClassScheme ;
                   skos:prefLabel "Small Station Wagon"@en .

:MidsizeStationWagon rdf:type skos:Concept ;
                     skos:broader :StationWagonClass ;
                     skos:inScheme :VehicleClassScheme ;
                     skos:prefLabel "Midsize Station Wagon"@en .

:MidsizeLargeStationWagon rdf:type skos:Concept ;
                          skos:broader :StationWagonClass ;
                          skos:inScheme :VehicleClassScheme ;
                          skos:prefLabel "Midsize-Large Station Wagon"@en .

:PickupTruck rdf:type skos:Concept ;
             skos:broader :TruckClass ;
             skos:inScheme :VehicleClassScheme ;
             skos:prefLabel "Pickup Truck"@en .

:SmallPickupTruck rdf:type skos:Concept ;
                  skos:broader :PickupTruck ;
                  skos:inScheme :VehicleClassScheme ;
                  skos:prefLabel "Small Pickup Truck"@en .

:StandardPickupTruck rdf:type skos:Concept ;
                     skos:broader :PickupTruck ;
                     skos:inScheme :VehicleClassScheme ;
                     skos:prefLabel "Standard Pickup Truck"@en .

:Minivan rdf:type skos:Concept ;
         skos:broader :VanClass ;
         skos:inScheme :VehicleClassScheme ;
         skos:prefLabel "Minivan"@en .

:PassengerVan rdf:type skos:Concept ;
              skos:broader :VanClass ;
              skos:inScheme :VehicleClassScheme ;
              skos:prefLabel "Passenger Van"@en .

:CargoVan rdf:type skos:Concept ;
